substitutions:
  name: esp32s2test
  friendly_name: "Lolin S2 Mini Test"

esphome:
  name: $name

esp32:
  board: esp32-s2-saola-1
  variant: esp32s2
  framework:
    type: esp-idf
    version: latest
    # Custom sdkconfig options
    sdkconfig_options:
      CONFIG_COMPILER_OPTIMIZATION_SIZE: y

# Enable logging
logger:

# Enable Home Assistant API
api:

ota:
  password: "5eab8f74bb01e754eeed4b68c4080ba1"

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

  # Enable fallback hotspot (captive portal) in case wifi connection fails
  ap:
    ssid: ${name} Hotspot
    password: "8bwgHTjZCQnM"

time:
  - platform: homeassistant
    id: homeassistant_time
    update_interval: 60min


# Text sensors with general information.
text_sensor:
  # Expose ESPHome version as sensor.
  - platform: version
    name: ${name} ESPHome Version
  # Expose WiFi information as sensors.
  - platform: wifi_info
    ip_address:
      name: ${name} IP
    ssid:
      name: ${name} SSID
    bssid:
      name: ${name} BSSID

light:
  - platform: status_led
    name: ${name} Status LED
    pin:
      number: GPIO15
      inverted: true


# Sensors with general information.
sensor:
  # Uptime sensor.
  - platform: uptime
    name: ${name} Uptime
    update_interval: 5min

  # WiFi Signal sensor.
  - platform: wifi_signal
    name: ${name} WiFi Signal
    update_interval: 5min
    id: ${name}_wifi


button:
  - platform: restart
    name: ${name} Restart
    id: ${name}_restart
    icon: "mdi:emoticon-outline"
    on_press:
      - logger.log: "Restart Button pressed"